# Application
APP_ENV=development
APP_NAME=RealEstateLeadBot
APP_DEBUG=true

# FastAPI
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# Database (MySQL)
DATABASE_URL=mysql+pymysql://relb:relbsecret@mysql:3306/real_estate_leads

# Authentication (for sales dashboard later)
JWT_SECRET=change-me-to-a-long-random-secret-key
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# n8n — use service name when running in Docker
N8N_WEBHOOK_URL=http://n8n:5678/webhook/lead-process-message
N8N_WEBHOOK_SECRET=change-me-n8n-secret
N8N_BASE_URL=http://localhost:5678
API_BASE_URL=http://backend:8000
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
SALES_NOTIFY_WEBHOOK_URL=

# LLM Provider Configuration (Groq)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=

# Legacy AI keys (for backwards compatibility)
AI_API_KEY=
AI_MODEL=openai/gpt-oss-120b

